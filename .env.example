# Copy to .env.local (gitignored) and fill in.

# Chronolens owns its own database and its own non-superuser role — it shares
# nothing with any other project. Create them with:
#   CREATE ROLE chronolens LOGIN PASSWORD '...';
#   CREATE DATABASE chronolens OWNER chronolens;
# then apply the schema with: npm run db:migrate
DATABASE_URL=postgresql://chronolens:PASSWORD@localhost:5432/chronolens

# Optional. Only used by the operator-side relevance scorer (`npm run score`) to
# classify ambiguous news. Without it that pass is skipped and events stay unscored,
# which still displays — nothing is hidden without a score.
# Visitors' own keys are NEVER stored here: bring-your-own-model runs entirely in
# the browser and never reaches the server.
# ANTHROPIC_API_KEY=
