# Copy to .env.local (gitignored) and fill in.

# Chronolens owns its own database and its own non-superuser role — it shares
# nothing with any other project. Create them with:
#   CREATE ROLE chronolens LOGIN PASSWORD '...';
#   CREATE DATABASE chronolens OWNER chronolens;
# then apply the schema with: npm run db:migrate
DATABASE_URL=postgresql://chronolens:PASSWORD@localhost:5432/chronolens

# Optional. Only used by the operator-side relevance scorer (`npm run score`) to
# classify ambiguous news. Without it that pass is skipped and events stay unscored,
# which still displays — nothing is hidden without a score.
# Visitors' own keys are NEVER stored here: bring-your-own-model runs entirely in
# the browser and never reaches the server.
# ANTHROPIC_API_KEY=

# ---------------------------------------------------------------- news repositories
# All optional. Each adapter skips silently when its key is absent, so the site runs
# with none of them set — the keyless sources (GDELT, Wikipedia, Chronicling America,
# SEC EDGAR, Federal Register, Yahoo Finance RSS) carry it on their own.
#
# ⚠ Every key below is on a NON-COMMERCIAL free tier as of 2026-07. They are fine for
# development and a private beta; they are NOT fine once the site earns money from ads
# or affiliate links. Resolve each one (upgrade, license, or drop) before that — the
# pre-release feed gate in docs/MASTER-CHECKLIST.md tracks them individually.
# NYT_API_KEY=
# GUARDIAN_API_KEY=
# NEWSDATA_API_KEY=
# GNEWS_API_KEY=
# CURRENTS_API_KEY=
# MARKETAUX_API_KEY=
# EODHD_API_KEY=
# FINNHUB_API_KEY=

# Set to true the moment anything on the site earns money. It withholds the key from
# every source flagged commercialOk:false in lib/ingest/store.ts, so a key left in this
# file cannot quietly keep serving a non-commercially-licensed feed. Adapters degrade to
# empty exactly as they do without a key, so a page never breaks.
# Verify the gate with: npm run check:commercial-mode
# COMMERCIAL_MODE=false
